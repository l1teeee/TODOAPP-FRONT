# Backend API base URL (Railway service). Local: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://vserwiaaxxlelecmabjb.supabase.co
# Supabase publishable (anon) key. Public by design; never put the service role key here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sVJ-Q6arMviicF-6w7xqlA_W3galsES
# Cloudflare Turnstile site key (public). The value below is Cloudflare's test key that always passes; set the real key in Vercel
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Sentry project todo-app-frontend DSN; empty disables Sentry
NEXT_PUBLIC_SENTRY_DSN=
# Sentry environment; defaults to NEXT_PUBLIC_VERCEL_ENV or development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Fraction of traces sent to Sentry
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1
# Build-time only; set in Vercel to upload source maps, never use NEXT_PUBLIC
SENTRY_AUTH_TOKEN=

# Email OTP code length; must equal Supabase Auth > Email OTP Length
NEXT_PUBLIC_OTP_LENGTH=6
